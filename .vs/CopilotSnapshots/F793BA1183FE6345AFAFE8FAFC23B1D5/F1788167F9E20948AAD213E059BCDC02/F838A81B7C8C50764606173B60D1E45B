    # --- Update on_scan logic ---
    def on_scan():
        global specs_dict, param_dict
        job_num = var_job.get()
        if not job_num:
            messagebox.showerror("Error", "Please enter a job number")
            return
        client = JobQueryClient()
        smart_string = client.get_part_description(job_num)
        if not smart_string:
            messagebox.showerror("Error", "Could not find part description for job number")
            return
        var_smartstring.set(smart_string)
        parsed_part_number, smartstring_travel = parse_smart_string(smart_string)
        if not parsed_part_number:
            messagebox.showerror("Error", "Could not parse part number from description")
            return
        if smartstring_travel:
            print(f"Travel from smart string: {smartstring_travel}")
        part_number.set(parsed_part_number)
        app = QApplication.instance()
        if app is None:
            app = QApplication([])
        app_instance = App()
        try:
            config_selections, param_dict = app_instance.show_popup_config_dialog(stage=parsed_part_number)
        except TypeError:
            app.quit()
            return
        if config_selections:
            specs_dict = config_selections
        else:
            print("No stage specifications found.")
        app_instance.deleteLater()
        del app_instance
        app.quit()

